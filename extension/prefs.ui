<?xml version="1.0" encoding="UTF-8"?>
<interface domain="xlr8login">
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <object class="AdwPreferencesPage" id="page">
    <property name="title" translatable="yes">xlr8login</property>
    <property name="icon-name">dialog-password-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Auto-submit</property>
        <property name="description" translatable="yes">Submit your account password automatically when the field reaches the configured length. Set the length to match your password.</property>
        <child>
          <object class="AdwSwitchRow" id="enabled_row">
            <property name="title" translatable="yes">Enable auto-submit</property>
            <property name="subtitle" translatable="yes">Submit after the configured number of characters</property>
          </object>
        </child>
        <child>
          <object class="AdwSpinRow" id="length_row">
            <property name="title" translatable="yes">Character count</property>
            <property name="subtitle" translatable="yes">Characters before auto-submit (4–32)</property>
            <property name="adjustment">length_adjustment</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="digits_row">
            <property name="title" translatable="yes">Digits only</property>
            <property name="subtitle" translatable="yes">Ignore non-digit keystrokes</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Safety</property>
        <property name="description" translatable="yes">After a failed auto-submit, auto-submit pauses until the next successful unlock or a settings change. Press Enter anytime to submit manually.</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Enter always works</property>
            <property name="subtitle" translatable="yes">Manual submit is never disabled</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="length_adjustment">
    <property name="lower">4</property>
    <property name="upper">32</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1</property>
  </object>
</interface>
