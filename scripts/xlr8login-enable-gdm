#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Enable the xlr8login extension on the GDM login screen.
set -euo pipefail

UUID='xlr8login@xlr8login'
DEST_DIR='/etc/dconf/db/gdm.d'
DEST="${DEST_DIR}/00-xlr8login"

if [[ ${EUID} -ne 0 ]]; then
    echo "Run as root: sudo $0" >&2
    exit 1
fi

if [[ ! -d /usr/share/gnome-shell/extensions/${UUID} ]]; then
    echo "Extension not installed system-wide at /usr/share/gnome-shell/extensions/${UUID}" >&2
    echo "Run: sudo make install   (or install the RPM)" >&2
    exit 1
fi

# Merge with any existing greeter enabled-extensions list.
EXISTING=()
if [[ -f ${DEST} ]]; then
    # shellcheck disable=SC2207
    EXISTING=($(sed -n "s/.*enabled-extensions=\[\(.*\)\]/\1/p" "${DEST}" | tr -d "'" | tr ',' ' '))
fi

MERGED=("${UUID}")
for ext in "${EXISTING[@]:-}"; do
    [[ -z ${ext} || ${ext} == "${UUID}" ]] && continue
    MERGED+=("${ext}")
done

LIST=""
for ext in "${MERGED[@]}"; do
    if [[ -n ${LIST} ]]; then
        LIST+=", "
    fi
    LIST+="'${ext}'"
done

install -d "${DEST_DIR}"
cat > "${DEST}" <<EOF
# Managed by xlr8login-enable-gdm — enables auto-submit on the login screen.
[org/gnome/shell]
enabled-extensions=[${LIST}]
EOF

dconf update
echo "Enabled ${UUID} for GDM greeter (${DEST})."
echo "Restart GDM to apply: sudo systemctl restart gdm"
echo "Warning: restarting GDM closes graphical sessions."
echo
echo "Per-user length/settings are read from:"
echo "  /var/lib/xlr8login/<username>.json"
echo "(written automatically when the extension runs in your session)."
install -d -m 1777 /var/lib/xlr8login
